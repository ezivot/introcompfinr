# Assign a debug version into the package namespace to replace it temporarily
debug_coef <- function(object, which_coef = c("mean", "volatility", "variance",
"covariance", "correlation"), ...) {
cat("DEBUG: which_coef =", which_coef, "\n")
cat("DEBUG: object$muhat =", object$muhat, "\n")
wc <- which_coef[1]
cat("DEBUG: wc =", wc, "\n")
cat("DEBUG: wc == 'mean':", wc == "mean", "\n")
if (wc == "mean") {
cat("DEBUG: returning muhat\n")
return(object$muhat)
}
}
environment(debug_coef) <- asNamespace("introcompfinr")
assignInNamespace("coef.gwn_model", debug_coef, ns = "introcompfinr")
# Re-register the S3 method
registerS3method("coef", "gwn_model", debug_coef, envir = asNamespace("introcompfinr"))
coef(gwn_fit, which_coef = "mean")
# Restore original and re-register it
orig <- function(object, which_coef = c("mean", "volatility", "variance",
"covariance", "correlation"), ...) {
which_coef = which_coef[1]
if(!(which_coef %in% c("mean", "volatility", "variance", "covariance", "correlation"))) {
stop("which_coef must be one of 'mean', 'volatility', 'variance', 'covariance', or 'correlation'")
}
if(which_coef == "mean") {
return(object$muhat)
} else if(which_coef == "volatility") {
return(object$sigmahat)
} else if(which_coef == "variance") {
return(object$sigma2hat)
} else if(which_coef == "covariance") {
return(object$covhat)
} else if(which_coef == "correlation") {
return(object$rhohat)
}
}
environment(orig) <- asNamespace("introcompfinr")
registerS3method("coef", "gwn_model", orig, envir = asNamespace("introcompfinr"))
assignInNamespace("coef.gwn_model", orig, ns = "introcompfinr")
